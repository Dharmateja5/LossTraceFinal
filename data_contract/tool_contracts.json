{
  "artifact_envelope": {
    "content": "text or typed record; never executable instructions",
    "labels": "assigned by source_policy before model access",
    "required": [
      "artifact_id",
      "sha256",
      "source_class",
      "integrity",
      "confidentiality",
      "document_date",
      "content",
      "locators"
    ]
  },
  "errors": {
    "DENIED": {
      "isError": true,
      "retryable": false
    },
    "NOT_FOUND": {
      "isError": true,
      "retryable": false
    },
    "TIMEOUT": {
      "execution_effect": "UNKNOWN",
      "isError": true
    }
  },
  "receipt_requirement": "Gateway records exact artifact hash, delivered text hash, recipient, tool call ID and delivered byte spans in evaluator telemetry. Treat delivery as exposure, not proof of model comprehension.",
