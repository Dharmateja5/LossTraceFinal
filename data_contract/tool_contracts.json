    {
      "idempotent": "depends on sandbox fixture; coordinator must reconcile before retry",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "additionalProperties": false,
            "properties": {
              "amount": {
                "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
                "type": "string"
              },
              "case_version": {
                "minimum": 1,
                "type": "integer"
              },
              "claim_id": {
                "minLength": 1,
                "type": "string"
              },
              "currency": {
                "const": "USD",
                "type": "string"
              },
              "decision_hash": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "evidence_hash": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "obligation_id": {
                "minLength": 1,
                "type": "string"
              },
              "policy_version": {
                "minLength": 1,
                "type": "string"
              },
              "target": {
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "const": "RECORD_SETTLEMENT_PAYMENT",
                "type": "string"
              }
            },
            "required": [
              "claim_id",
              "target",
              "type",
              "amount",
              "currency",
              "case_version",
              "decision_hash",
              "evidence_hash",
              "policy_version",
              "obligation_id"
            ],
            "type": "object"
          },
          "grant": {
            "additionalProperties": false,
            "properties": {
              "action_hash": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "actor": {
                "minLength": 1,
                "type": "string"
              },
              "expires_at": {
                "type": "integer"
              },
              "grant_id": {
                "minLength": 1,
                "type": "string"
              },
              "issued_at": {
                "type": "integer"
              },
              "issuer": {
                "minLength": 1,
                "type": "string"
              },
              "scope": {
                "minLength": 1,
                "type": "string"
              },
              "signature": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "single_use": {
                "const": true,
                "type": "boolean"
              }
            },
            "required": [
              "grant_id",
              "issuer",
              "actor",
              "scope",
              "action_hash",
              "issued_at",
              "expires_at",
              "single_use",
              "signature"
            ],
            "type": "object"
          }
        },
        "required": [
          "action",
          "grant"
        ],
        "type": "object"
      },
      "name": "record_settlement_payment",
      "operation": "WRITE",
      "response_contract": "WriteResult",
      "role_allowlist": [
        "DeterministicExecutor"
      ],
      "scope": "settlement.write"
    }
  ],
  "version": "1.5"
